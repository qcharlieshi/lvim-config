#!/usr/bin/env bash
# `claude` through herdr: start the agent headless in herdr (this repo's cockpit project) and attach
# to it in this tmux pane. Looks like plain claude, but shows in the cockpit rail, can be forked and
# survives the pane. Every failure falls back to plain claude after one warning line.
# Bypass: COCKPIT_NO_HERDR=1, not in tmux, already inside herdr, -p/--print/-v/--version/-h/--help,
# a subcommand / positional prompt (first arg not starting with -), or outside a git repo (silent).
NVIM_CFG=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

plain() { exec claude "$@"; } # a script never sees the zsh claude() function: no recursion
warn() { printf 'cockpit-claude: %s — running plain claude\n' "$1" >&2; }

[ -z "${TMUX:-}" ] || [ "${HERDR_ENV:-}" = 1 ] || [ "${COCKPIT_NO_HERDR:-}" = 1 ] && plain "$@"
[ $# -gt 0 ] && [ "${1#-}" = "$1" ] && plain "$@"
for a in "$@"; do
  case $a in -p | --print | -v | --version | -h | --help) plain "$@" ;; esac
done
git rev-parse --show-toplevel >/dev/null 2>&1 || plain "$@" # no project to put it in: silently plain

H=(herdr)
[ -n "${COCKPIT_HERDR_SESSION:-}" ] && H+=(--session "$COCKPIT_HERDR_SESSION")

errf=$(mktemp "${TMPDIR:-/tmp}/cockpit-claude.XXXXXX")
out=$(nvim --headless -u NONE -i NONE --cmd "set rtp^=$NVIM_CFG" \
  -l "$NVIM_CFG/scripts/cockpit-spawn.lua" -- "$PWD" "$@" 2>"$errf" </dev/null)
rc=$?
reason=$(grep -m1 . "$errf")
rm -f "$errf"
read -r name pane <<<"$out"
if [ $rc -ne 0 ] || [ -z "$name" ] || [ -z "$pane" ]; then
  warn "${reason:-spawn failed}"
  plain "$@"
fi

# agent state: live | gone (herdr says agent_not_found) | unknown (server slow/unreachable, other errors)
state() {
  local out
  out=$("${H[@]}" agent get "$name" 2>&1) && {
    echo live
    return
  }
  case $out in *'"code":"agent_not_found"'*) echo gone ;; *) echo unknown ;; esac
}

# attach doesn't return when Claude exits (the pane's shell lives on): once herdr has reported the
# agent not found 5 times in a row (1 s apart), close its pane, which ends the attach — no empty
# shell panes pile up. Only an explicit agent_not_found counts; unknown neither counts nor resets.
(
  misses=0
  while [ $misses -lt 5 ]; do
    sleep 1
    case $(state) in live) misses=0 ;; gone) misses=$((misses + 1)) ;; esac
  done
  "${H[@]}" pane close "$pane" >/dev/null 2>&1
) </dev/null >/dev/null 2>&1 &
watcher=$!

"${H[@]}" agent attach "$name"
arc=$?
kill "$watcher" 2>/dev/null
wait "$watcher" 2>/dev/null

# attach returns on detach (agent keeps running in herdr) or when the watcher closed the pane
[ "$(state)" = gone ] && exit 0
[ $arc -ne 0 ] && printf 'cockpit-claude: attach ended — %s still running in herdr (herdr agent attach %s)\n' "$name" "$name" >&2
exit $arc
